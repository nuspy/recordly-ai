<?xml version="1.0" encoding="utf-8"?>
<InstallForgeProject>
  <Metadata productVersion="1.6.1" projectFileVersion="2.0" />
  <ProductInformation>
    <Name>Recordly AI</Name>
    <Version>1.4.0</Version>
    <CompanyName>Tadamoo</CompanyName>
    <WebURI>https://github.com/webadderallorg/Recordly</WebURI>
  </ProductInformation>
  <InstallerConfiguration>
    <Prerequisites>
      <OperatingSystem check="true">
        <WindowsXP>false</WindowsXP>
        <WindowsServer2003>false</WindowsServer2003>
        <WindowsVista>false</WindowsVista>
        <WindowsServer2008>false</WindowsServer2008>
        <Windows7>false</Windows7>
        <Windows8>false</Windows8>
        <Windows10>true</Windows10>
        <WindowsServer2016>true</WindowsServer2016>
        <WindowsServer2019>true</WindowsServer2019>
        <WindowsServer2022>true</WindowsServer2022>
        <Windows11>true</Windows11>
        <WindowsServer2025>true</WindowsServer2025>
      </OperatingSystem>
    </Prerequisites>
    <UserInterface>
      <WizardImage filePath="C:\Program Files\solicus\InstallForge\images\Wizard_2.bmp" />
      <HeaderImage filePath="C:\Program Files\solicus\InstallForge\images\Header_3.png" />
      <Label isEnabled="true" />
      <VisualStyle isEnabled="true" />
    </UserInterface>
    <InstallationFiles defaultInstallationPath="&lt;ProgramFilesX64&gt;\Recordly AI\" isDefaultInstallationPathAlterable="true">
      <InstallationFile type="[Folder]" size="N/A">E:\Projects\recordly\release\installforge\stage\app\</InstallationFile>
    </InstallationFiles>
    <Languages>
      <Language>English</Language>
      <Language>Italiano</Language>
    </Languages>
    <Variables />
    <Commands>
      <Command type="Execute Application" commandLineArguments="/install /quiet /norestart" options="-wait -hide" command="&lt;InstallPath&gt;\app\prereq\vc_redist.x64.exe" />
    </Commands>
    <Registry />
    <Shortcuts defaultPath="&lt;Company&gt;\&lt;AppName&gt;\" isDefaultPathAlterable="true" isCreateStartmenuShortcutsForAllUsers="true" isCreateDesktopShortcutsForAllUsers="true">
      <Shortcut name="Recordly AI" iconFilePath="E:\Projects\recordly\icons\icons\win\icon.ico" commandLineArguments="" iconIndex="0" targetFile="&lt;InstallPath&gt;\app\RecordlyAI.exe" destination="Desktop" />
      <Shortcut name="Recordly AI" iconFilePath="E:\Projects\recordly\icons\icons\win\icon.ico" commandLineArguments="" iconIndex="0" targetFile="&lt;InstallPath&gt;\app\RecordlyAI.exe" destination="Startmenu" />
      <Shortcut name="Recordly AI (server)" iconFilePath="E:\Projects\recordly\icons\icons\win\icon.ico" commandLineArguments="--server" iconIndex="0" targetFile="&lt;InstallPath&gt;\app\RecordlyAI.exe" destination="Startmenu" />
      <Shortcut name="Uninstall Recordly AI" iconFilePath="E:\Projects\recordly\icons\icons\win\icon.ico" commandLineArguments="" iconIndex="0" targetFile="&lt;InstallPath&gt;\Uninstall.exe" destination="Startmenu" />
    </Shortcuts>
    <Serials isDialogEnabled="false" count="1000" mask="#####-#####-#####-#####" />
    <SplashScreen isDialogEnabled="false" delayTime="2">
      <Image filePath="" />
      <Sound isEnabled="false" filePath="" />
    </SplashScreen>
    <License isDialogEnabled="true">
      <Data></Data>
    </License>
    <Finish isRebootMachineEnabled="false">
      <Program executableFilePath="&lt;InstallPath&gt;\app\RecordlyAI.exe" isLaunchEnabled="false" arguments="" />
    </Finish>
  </InstallerConfiguration>
  <UninstallerConfiguration isPackaged="true">
    <UninstallerExecutableFileName>Uninstall</UninstallerExecutableFileName>
    <OpenWebURIAfterUninstallation isEnabled="false">https://</OpenWebURIAfterUninstallation>
    <CustomDisplayIcon isEnabled="false" iconFilePath="&lt;InstallPath&gt;\" />
  </UninstallerConfiguration>
  <VisualUpdateConfiguration isPackaged="false">
    <ProductName>Recordly AI</ProductName>
    <ProductVersion>&lt;AppVersion&gt;</ProductVersion>
    <Language>0</Language>
    <UpdateScriptURIs>
      <MainURI>https://</MainURI>
      <FirstMirrorURI>https://</FirstMirrorURI>
      <SecondMirrorURI>https://</SecondMirrorURI>
    </UpdateScriptURIs>
    <updateExecutableFileName>Update</updateExecutableFileName>
    <proEditionLicenseKey />
    <Program executableFilePath="" isLaunchEnabled="true" isTerminationEnabled="true" />
  </VisualUpdateConfiguration>
  <BuildConfiguration>
    <SetupFilePath>E:\Projects\recordly\release\installforge\RecordlyAI-1.4.0-setup.exe</SetupFilePath>
    <SetupIconPath>E:\Projects\recordly\icons\icons\win\icon.ico</SetupIconPath>
    <UninstallerIconPath>E:\Projects\recordly\icons\icons\win\icon.ico</UninstallerIconPath>
    <Compression method="0" level="2" />
    <CodeSigning isEnabled="false" signToolCommandLine="/n &quot;Subject&quot; /tr http://timestamp.digicert.com /td sha256 /fd sha256 &quot;&lt;ExecutableFilePath&gt;&quot;" />
  </BuildConfiguration>
</InstallForgeProject>